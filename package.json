	"license": "MIT",
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"db:gen": "drizzle-kit generate",
		"db:push": "drizzle-kit push",
		"db:std": "drizzle-kit studio",
		"typecheck": "tsc --noEmit",
