  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:gen": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:std": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "fmt": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome check --write",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@hookform/resolvers": "^5.9.1",
    "@orpc/client": "^2.0.0-beta.37",
    "@orpc/server": "^2.0.0-beta.37",
    "@orpc/tanstack-query": "^2.0.0-beta.37",
    "@tanstack/react-query": "^5.103.1",
    "better-auth": "^1.7.5",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "dotenv": "^18.0.1",
    "drizzle-orm": "^1.0.0-rc.4",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.1",
    "pg": "^8.23.0",
    "react": "19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.88.0",
    "react-resizable-panels": "^4.12.4",
    "recharts": "3.10.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "vaul": "^1.1.2",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.103.1",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^1.0.0-rc.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "postcss": "^8.5.28",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animated": "^2.1.0",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
      "biome check --write --no-errors-on-unmatched",
      "biome check --write --unsafe --no-errors-on-unmatched",
      "biome format --write --no-errors-on-unmatched",
      "biome lint --write --no-errors-on-unmatched"
    ]
  }
}
