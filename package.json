		"@tanstack/react-query": "^5.105.3",
		"better-auth": "^1.7.15",
		"class-variance-authority": "^0.7.1",
		"cmdk": "^1.1.1",
		"cn": "^0.5.2",
		"dotenv": "^18.0.9",
		"drizzle-orm": "^1.0.0-rc.5-ab785fc",
		"embla-carousel-react": "^8.6.0",
		"input-otp": "^1.5.0",
		"lucide-react": "^1.66.0",
		"motion": "^14.9.0",
		"next": "16.4.4",
		"next-themes": "^0.4.6",
		"nuqs": "^2.10.2",
		"pg": "^8.23.1",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"react-hook-form": "^7.91.0",
